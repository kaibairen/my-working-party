{
  "name": "boundary-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && npm run test:unit && npm run test:ready-anti && npm run test:security-anti",
    "test:unit": "node --import tsx --test apps/api/test/*.test.ts",
    "test:ready-anti": "node --test qa/a5/fourteen/appendix_a5_fourteen.test.mjs",
    "test:security-anti": "node --import tsx --test apps/api/tests/security-anti/*.test.ts",
    "start": "npm run build -w @boundary-harness/domain && npm run start -w @boundary-harness/api",
    "token": "tsx apps/api/src/issue-token.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
