{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "data", "packages/domain/drizzle.config.ts", "tests/e2e/**", "playwright.config.ts"]
}
