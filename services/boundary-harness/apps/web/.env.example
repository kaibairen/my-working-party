# mock (default) — demoable without Domain API
# api — GET /v1/gates?status=ready and POST /v1/gates/{id}/decide
VITE_DATA_SOURCE=mock

# Empty = same-origin /v1 (Vite proxies to VITE_API_PROXY_TARGET, default :8080)
VITE_API_BASE_URL=

# Bearer token for Domain API (decision_maker)
VITE_API_TOKEN=

# Optional SSE stub: GET /v1/events/stream (list+decide does not depend on this)
VITE_SSE_ENABLED=false

# Dev-server proxy target when VITE_API_BASE_URL is empty
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
